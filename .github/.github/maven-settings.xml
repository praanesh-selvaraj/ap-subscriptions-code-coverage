<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>central</id>
            <username>${env.AWS_ACCESS_KEY_ID}</username>
            <password>${env.AWS_SECRET_ACCESS_KEY}</password>
        </server>
        <server>
            <id>snapshots</id>
            <username>${env.AWS_ACCESS_KEY_ID}</username>
            <password>${env.AWS_SECRET_ACCESS_KEY}</password>
        </server>
    </servers>
    <profiles>
        <profile>
            <id>aeroparker-ci</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <java.version>1.8</java.version>
                <url.libs-release>s3://aeroparker-maven/release</url.libs-release>
                <url.libs-snapshot>s3://aeroparker-maven/snapshot</url.libs-snapshot>
                <url.ext-release-local>s3://aeroparker-maven/release</url.ext-release-local>
                <url.ext-snapshot-local>s3://aeroparker-maven/snapshot</url.ext-snapshot-local>
                <url.central>https://repo.maven.apache.org/maven2</url.central>
            </properties>
            <repositories>
                <repository>
                    <id>maven-central</id>
                    <url>${url.central}</url>
                </repository>
                <repository>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                    <id>central</id>
                    <name>libs-release</name>
                    <url>${url.libs-release}</url>
                </repository>
                <repository>
                    <snapshots/>
                    <id>snapshots</id>
                    <name>libs-snapshot</name>
                    <url>${url.libs-snapshot}</url>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                    <id>central</id>
                    <name>plugins-release</name>
                    <url>${url.central}</url>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>
</settings>
