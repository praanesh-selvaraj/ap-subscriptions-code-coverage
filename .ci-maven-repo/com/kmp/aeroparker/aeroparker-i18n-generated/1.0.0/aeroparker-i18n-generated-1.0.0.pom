<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.kmp.aeroparker</groupId>
    <artifactId>aeroparker-i18n</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>aeroparker-i18n-generated</artifactId>
  
  <dependencies>
		<dependency>
			<groupId>org.jooq</groupId>
				<artifactId>jooq-codegen-maven</artifactId>
				<version>3.11.11</version>
		</dependency>
	</dependencies>
  <build>
  <finalName>aeroparker-il8n-generated</finalName>
  <plugins>
			<plugin>
				<!-- Specify the maven code generator plugin -->
				<groupId>org.jooq</groupId>
				<artifactId>jooq-codegen-maven</artifactId>
				<version>3.11.11</version>
				<!-- The plugin should hook into the generate goal -->
				<executions>
					<execution>
						<goals>
							<goal>generate</goal>
						</goals>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>mysql</groupId>
						<artifactId>mysql-connector-java</artifactId>
						<version>5.1.46</version>
					</dependency>
				</dependencies>
				<configuration>
					<jdbc>
						<driver>com.mysql.jdbc.Driver</driver>
						<!-- These should be set in your active profile in the maven settings.xml -->
						<url>${jdbc.url}</url>
						<user>${jdbc.user}</user>
						<password>${jdbc.password}</password>
					</jdbc>
					<generator>
						<name>org.jooq.codegen.JavaGenerator</name>
						<database>
							<name>org.jooq.meta.mysql.MySQLDatabase</name>
							<includes>ab_lang.*|languages|ab_language_key_translation</includes>
							<excludes></excludes>
							<inputSchema>kmp_advancebooker</inputSchema>
							<outputSchemaToDefault>true</outputSchemaToDefault>
						</database>

						<generate>
							<deprecated>false</deprecated>
							<pojos>true</pojos>
							<daos>true</daos>
						</generate>
						<target>
							<packageName>com.kmp.aeroparker.i18n</packageName>
							<directory>src/main/generated</directory>
						</target>
					</generator>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.1.0</version>
				<configuration>
					<filesets>
						<fileset>
							<directory>src/main/generated</directory>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
		</plugins>
  </build>
</project>