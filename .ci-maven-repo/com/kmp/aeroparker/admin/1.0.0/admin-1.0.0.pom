<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>admin</artifactId>
	<packaging>war</packaging>
	<url>http://www.aeroparker.com</url>
	<properties>
		<java-version>1.8</java-version>
		<aeroparker-version>1.0.0</aeroparker-version>
		<webscraper-lib-version>1.0.0</webscraper-lib-version>
		<javax.servlet-api-version>3.1.0</javax.servlet-api-version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<aeroparker-snapshot-version>0.0.1-SNAPSHOT</aeroparker-snapshot-version>
		<maven.build.timestamp.format>yyyy-MM-dd-HH-mm-ss</maven.build.timestamp.format>
	</properties>
	<distributionManagement>
		<repository>
			<id>central</id>
			<name>releases</name>
			<url>${url.ext-release-local}</url>
		</repository>
		<snapshotRepository>
			<id>snapshots</id>
			<name>snapshots</name>
			<url>${url.ext-snapshot-local}</url>
		</snapshotRepository>
	</distributionManagement>
	<parent>
		<groupId>com.kmp.aeroparker</groupId>
		<artifactId>aeroparker-build</artifactId>
		<version>1.0.0</version>
		<relativePath>../aeroparker-build/pom.xml</relativePath>
	</parent>
	<dependencies>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-common</artifactId>
			<version>${aeroparker-snapshot-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-common-generated</artifactId>
			<version>${aeroparker-snapshot-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>webscraper-lib</artifactId>
			<version>${webscraper-lib-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-parking-quotas-admin</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-parking-upgrades-admin</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-buckets-admin</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-ancillary-quotas-admin</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-reports-core</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-payments-admin</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-crm-admin</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-aerotimetable-generated</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-travel-extras-generated</artifactId>
			<version>${aeroparker-snapshot-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-subscription-quotas-admin</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>net.sf.supercsv</groupId>
			<artifactId>super-csv</artifactId>
			<version>2.2.0</version>
		</dependency>
		<dependency>
			<groupId>com.j2html</groupId>
			<artifactId>j2html</artifactId>
			<version>0.88</version>
		</dependency>
		<dependency>
			<groupId>org.apache.tomcat</groupId>
			<artifactId>tomcat-coyote</artifactId>
			<version>7.0.100</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
			<version>2.16.1</version>
		</dependency>
		<dependency>
		    <groupId>commons-fileupload</groupId>
		    <artifactId>commons-fileupload</artifactId>
		    <version>1.5</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-setup-wizard-admin</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
			<version>${javax.servlet-api-version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-common-test</artifactId>
			<version>${aeroparker-snapshot-version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-active-directory-admin</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>net.bull.javamelody</groupId>
			<artifactId>javamelody-core</artifactId>
			<version>1.78.0</version>
		</dependency>
		<dependency>
			<groupId>se.jiderhamn.classloader-leak-prevention</groupId>
			<artifactId>classloader-leak-prevention-servlet3</artifactId>
			<version>2.7.0</version>
		</dependency>
		<dependency>
			<groupId>com.googlecode.htmlcompressor</groupId>
			<artifactId>htmlcompressor</artifactId>
			<version>1.5.2</version>
		</dependency>
		<dependency>
			<groupId>com.yahoo.platform.yui</groupId>
			<artifactId>yuicompressor</artifactId>
			<version>2.4.8</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-release-notes</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
		    <groupId>ch.qos.reload4j</groupId>
		    <artifactId>reload4j</artifactId>
			<version>1.2.20</version>
		</dependency>
		<dependency>
		    <groupId>com.sun.mail</groupId>
		    <artifactId>jakarta.mail</artifactId>
		    <version>1.6.7</version>
		</dependency>
		<dependency>
            <groupId>org.owasp</groupId>
            <artifactId>csrfguard</artifactId>
            <version>4.4.0</version>
        </dependency>
        <dependency>
            <groupId>org.owasp</groupId>
            <artifactId>csrfguard-extension-session</artifactId>
            <version>4.4.0</version>
        </dependency>
	</dependencies>
	<build>
		<finalName>Admin</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>2.1</version>
				<configuration>
					<source>${java-version}</source>
					<target>${java-version}</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<version>2.6</version>
				<configuration>
					<overlays>
						<overlay>
							<id>aeroparker-parking-quotas-admin</id>
							<groupId>com.kmp.aeroparker</groupId>
							<artifactId>aeroparker-parking-quotas-admin</artifactId>
							<type>jar</type>
							<includes>
								<include>**/*.jsp</include>
							</includes>
						</overlay>
						<overlay>
							<id>aeroparker-payments-admin</id>
							<groupId>com.kmp.aeroparker</groupId>
							<artifactId>aeroparker-payments-admin</artifactId>
							<type>jar</type>
							<includes>
								<include>**/*.jsp</include>
							</includes>
						</overlay>
						<overlay>
							<id>aeroparker-parking-upgrades</id>
							<groupId>com.kmp.aeroparker</groupId>
							<artifactId>aeroparker-parking-upgrades-admin</artifactId>
							<type>jar</type>
							<includes>
								<include>**/*.jsp</include>
							</includes>
						</overlay>
						<overlay>
							<id>aeroparker-ancillary-quotas-admin</id>
							<groupId>com.kmp.aeroparker</groupId>
							<artifactId>aeroparker-ancillary-quotas-admin</artifactId>
							<type>jar</type>
							<includes>
								<include>**/*.jsp</include>
							</includes>
						</overlay>
						<overlay>
							<id>aeroparker-buckets-admin</id>
							<groupId>com.kmp.aeroparker</groupId>
							<artifactId>aeroparker-buckets-admin</artifactId>
							<type>jar</type>
							<includes>
								<include>**/*.jsp</include>
							</includes>
						</overlay>
						<overlay>
							<id>aeroparker-parking-upgrades-admin</id>
							<groupId>com.kmp.aeroparker</groupId>
							<artifactId>aeroparker-parking-upgrades-admin</artifactId>
							<type>jar</type>
							<includes>
								<include>**/*.jsp</include>
							</includes>
						</overlay>
						<overlay>
							<id>aeroparker-crm-admin</id>
							<groupId>com.kmp.aeroparker</groupId>
							<artifactId>aeroparker-crm-admin</artifactId>
							<type>jar</type>
							<includes>
								<include>**/*.jsp</include>
							</includes>
						</overlay>
						<overlay>
							<id>aeroparker-reports-core</id>
							<groupId>com.kmp.aeroparker</groupId>
							<artifactId>aeroparker-reports-core</artifactId>
							<type>jar</type>
							<includes>
								<include>**/*.jsp</include>
							</includes>
						</overlay>
						<overlay>
							<id>aeroparker-active-directory-admin</id>
							<groupId>com.kmp.aeroparker</groupId>
							<artifactId>aeroparker-active-directory-admin</artifactId>
							<type>jar</type>
							<includes>
								<include>**/*.jsp</include>
							</includes>
						</overlay>
						<overlay>
							<id>aeroparker-setup-wizard-admin</id>
							<groupId>com.kmp.aeroparker</groupId>
							<artifactId>aeroparker-setup-wizard-admin</artifactId>
							<type>jar</type>
							<includes>
								<include>**/*.jsp</include>
								<include>**/*.js</include>
							</includes>
						</overlay>
						<overlay>
							<id>aeroparker-subscription-quotas-admin</id>
							<groupId>com.kmp.aeroparker</groupId>
							<artifactId>aeroparker-subscription-quotas-admin</artifactId>
							<type>jar</type>
							<includes>
								<include>**/*.jsp</include>
							</includes>
						</overlay>
					</overlays>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>com.google.cloud.tools</groupId>
					<artifactId>jib-maven-plugin</artifactId>
					<version>3.3.2</version>
					<configuration>
						<from>
							<image>515903409859.dkr.ecr.eu-west-1.amazonaws.com/aeroparker-tomcat:${from.image.tag}</image>
						</from>
						<to>
							<image>${aws.ecr.repo}/aeroparker-admin:${image.tag.latest}</image>
							<tags>
								<tag>${image.tag.timestamp}</tag>
							</tags>
						</to>
						<extraDirectories>
							<paths>
								<path>
									<from>../third_party/opentelemetry-javaagent/release</from>
									<into>/otel</into>
								</path>
							</paths>
						</extraDirectories>
						<container>
							<appRoot>/usr/local/tomcat/webapps/${image.approot}</appRoot>
							<environment>
								<JAVA_OPTS>-DDB_URL="${DB_URL}" -DDB_USER=${DB_USER} -DDB_PASSWORD=${DB_PASSWORD} -DDB_MAX_POOL_SIZE=${DB_MAX_POOL_SIZE} -DDB_MIN_IDLE=${DB_MIN_IDLE} -DLOG_FILE=/AdvanceBooker/config/log/log4j.xml -Dlog.email.from=${LOG_EMAIL_FROM} -Dlog.email.to=${LOG_EMAIL_TO} -Dlog.email.subject="${LOG_EMAIL_SUBJECT}" -Dlog.level=${LOG_LEVEL} -Dadmin.reportsUrl=${ADMIN_REPORTS_URL} -javaagent:/otel/opentelemetry-javaagent.jar</JAVA_OPTS>
							</environment>
						</container>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
	<name>AeroParker Admin Application</name>
	<description>The Tomcat web application for Admin.</description>
</project>
