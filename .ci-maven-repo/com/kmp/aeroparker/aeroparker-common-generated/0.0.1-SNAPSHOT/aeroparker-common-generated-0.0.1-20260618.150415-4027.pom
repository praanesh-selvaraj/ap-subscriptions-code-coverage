<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.kmp.aeroparker</groupId>
		<artifactId>aeroparker-build</artifactId>
		<version>1.0.0</version>
		<relativePath>../aeroparker-build/pom.xml</relativePath>
	</parent>

	<name>AeroParker - Common Generated</name>
	<url>http://www.aeroparker.com</url>

	<artifactId>aeroparker-common-generated</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<distributionManagement>
		<repository>
			<id>central</id>
			<name>releases</name>
			<url>${url.ext-release-local}</url>
		</repository>
		<snapshotRepository>
			<id>snapshots</id>
			<name>snapshots</name>
			<url>${url.ext-snapshot-local}</url>
		</snapshotRepository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<aeroparker-snapshot-version>0.0.1-SNAPSHOT</aeroparker-snapshot-version>
		<aeroparker-version>1.0.0</aeroparker-version>
		<checkstyle.version>2.17</checkstyle.version>
		<jooq-version>3.10.8</jooq-version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-common-db</artifactId>
			<version>${aeroparker-snapshot-version}</version>
		</dependency>
	</dependencies>

	<build>
		<finalName>aeroparker-common-generated</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>2.1</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
			<plugin>
				<!-- Specify the maven code generator plugin -->
				<groupId>org.jooq</groupId>
				<artifactId>jooq-codegen-maven</artifactId>
				<version>${jooq-version}</version>
				<!-- The plugin should hook into the generate goal -->
				<executions>
					<execution>
						<goals>
							<goal>generate</goal>
						</goals>
					</execution>
				</executions>
				<!-- Manage the plugin's dependency. In this example, we'll use a PostgreSQL 
					database -->
				<dependencies>
					<dependency>
						<groupId>mysql</groupId>
						<artifactId>mysql-connector-java</artifactId>
						<version>8.0.33</version>
					</dependency>
					<dependency>
						<groupId>com.kmp.aeroparker</groupId>
						<artifactId>aeroparker-common-db</artifactId>
						<version>${aeroparker-snapshot-version}</version>
					</dependency>
				</dependencies>
				<!-- Specify the plugin configuration. The configuration format is the 
					same as for the standalone code generator -->
				<configuration>
					<jdbc>
						<driver>com.mysql.jdbc.Driver</driver>
						<!-- These should be set in your active profile in the maven settings.xml -->
						<url>${jdbc.url}</url>
						<user>${jdbc.user}</user>
						<password>${jdbc.password}</password>
					</jdbc>
					<generator>
						<name>org.jooq.util.JavaGenerator</name>
						<database>
							<name>org.jooq.util.mysql.MySQLDatabase</name>
							<includes>
								ab_callcentre.*|ab_confirmation.*|ab_consolidator.*|ab_affiliates_footer.*|ab_affiliates_metadata*|ab_populate_generic.*|ab_sent_bookings.*|ab_sequence.*|
								ab_ftp_listeners.*|ab_extras.*|ab_affiliate.*|ab_bookings.*|ab_carparks.*|ab_product.*|ab_sites.*|
								affiliate.*|ab_affiliates_cancellation_charge_settings.*|
								ab_emails.*|airline.*|barriers.*|car_park.*|categories.*|contacts_loyalty.*|get_barrier_entry_exit.*|get_thirdparty_barrier_entry_exit.*|
								payment_gateway.*|product_media*|shop_product_media*|site_alert_email.*|site_external_user.*|
								products_car_parks_barrier_codes.*|email_queue.*|loyalty_.*|promotions_loyalty.*|
								sites_third_party.*|site_third_party.*|third_party_availability.*|
								multi_purchase_media.*|product_barrier_override_settings.*|vehiclelookup.*|contact_hashed_password|languages|contact_login_token|
								migration_contact|ab_bookings_product_upgrades|ab_products_upgrade.*|affiliate_pass_kit_settings|barrier_booking_barcode|barrier_booking_third_party_barcode|contact_login_attempt|
								loyalty_point_distributions|loyalty_point_distributions_constraints|social_auth_contact|communicator_contacts|ab_automated_reports_products_to_include|
								overstay_full_information_view|overstay_charge|overstay_charge_attempt|site_overstay_email|ab_saveforlater|crm_scheduled_email_affiliate|
								parking_upgrade_affiliate|api_users|api_request_key.*|call_centre_user_site|ab_call_centre_users|call_centre_user_information|ab_agency_users|ab_agency_bookings|
								reservation_user|ab_activity_log_item_aguser|site_availability_api_configuration|ab_affiliates_display|site_booking_api_configuration.*|
								activity_log_item|activity_log_booking|activity_log_shop_order|postcode_lookup_config|feature_flag|site_api_user_configuration|
								site_group_site|site_group|locations|ab_auto_saved_reports_overstay_status|admin_users_sites|ab_contacts|locations|ab_auto_saved_reports|
								payment_step.*|product_rule_days|site_availability_api_configuration_car_park|ideas_product|external_reservation|advam_product|
								advam_booking_reservation|hourly_pricings|linked_products|site_cloned_lookup|external_product|ab_terminals|bucket_sets|buckets|availability_range_bucket_sets
								|site_flight_lookup_type|aerotimetable_isavia_slots|isavia_flight_lookup|aerotimetable_slots_structure|aero_flight_lookup|site_destination
								|ab_reports_recipients|contact_csrf_token|innovata_flight_lookup|sfo_flight_lookup_view|post_purchase.*|product_change_log|product_change_log_date_range|
								product_change_log_time_range|product_change_log_rule_days|product_rule_days|availability_range_bucket_sets|activity_log_thirdparty_booking|
								affiliate_flight_lookup_times_settings|ab_call_centre_users_columns|ab_agency_users_columns|currencies|ab_uploaded_images
								|ab_booking_notes|ab_booking_thirdparty_notes|affiliate_subscription_.*|subscription_.*|crm_sms_amazon_settings|ab_shop_order_notes|ab_contacts_vehicles|
								affiliate_subscription_settings|country_codes|contact_country_code|company.*|product_category.*|site_subscription_alert_email|car_park_drop_off|
								booking_drop_off|orbility_configuration|ancillary_group|ancillary_group_products|ancillary_group_affiliates|ancillary_group_appearance|booking_price_details|booking_language_thirdparty|
								shop_order_language|booking_placeholders.*|payment_invoice|ab_confirmation_language|product_availability_restrict_rule|api_users_scope|booking_iso_code|newsletter_smart_data_config|
								munich_opt_in_description|products_drafts_promotions|cognito.*|tax_periods|contact_tax_receipt_details|call_centre_user_archive|admin_users|admin_users_token|admin_user_hashed_password|
								ab_shop_products|refer_a_friend.*|automated_reports_parking_status_filters
								|my_account_parking_booking|ancillary_placeholders|ancillary_extras_placeholders|reservation_booking|ab_shop_product_terminals|release_notes|release_notes_user_status|site_confirmation_redirect_setting.*|
								affiliate_icalendar_settings|affiliate_icalendar_enabled|crm_refer_a_friend_email|ancillary_recipient_email|affiliate_understay|contact_munich_opt_in_settings|admin_password_history|quotas_product_occupancy_day
								|configurable_confirmation_page.*|contact_session_detail|crm_email|ancillary_extra_invoice|refund_placeholders|refund_item_placeholders|crm_refund_email|crm_refund_email_affiliate|admin_user_type.*|booking_invoice_url
								|booking_custom_value|site_geolocation_configuration|locations_airport|ancillary_locations_airport|site_sync|shop_order_receipt_details|country|call_centre_password_history|agency_user_hashed_password|shop_order_currency_conversion.*|shop_order_invoice_url
								|agency_password_history|currencies|ancillary_base_currency|ancillary_currency|voucher_multi_use_transaction|customer_history|quicksight.*|crm_voucher_email|basket_status|booking_star_rating|product_recipient_email|shop_order_customer_history
								|shop_product_bundle.*|payment_step_fields_car_park|reservation_basket_item_simple_ticket_bundle_ticket|reservation_basket_item_extra_bundle_ticket|shop_order_items.*||admin_activity_log|kowee_product|ab_shop_product_config_simple_ticket
								|shop_product_destination|site_availability_api_configuration_ancillary|affiliate_active_booking_amend_rules|reservation|reservation_external_ancillary|third_party_customer_history|site_external_api_config|booking_price_reduction
								|price_tech_product|reservation_parking_product_record|reservation_ancillary_product_record|reservation_query|shop_front.*|shop_product_extra_hour_appearance|lounge_tariff_extra_hour|ab_shop_tariffs_lounge|reservation_extra_hour|shop_order_extra_hour
								|grace_period_occupancy_booking_time|pay_as_you_go_tariff|pay_as_you_go_transaction|reservation_pay_as_you_go_charge|product_tariff_override|site_overstay_payment_setting|call_centre_payment_link|payment_link_reserved_ancillary_ticket|overstay_placeholders
								|skidata_reusable_ticket|loyalty_settings_affiliate|overstay_charge_refund|overstay_charge_lookup|crm_scheduled_payg_email_sent|crm_scheduled_email_constraint|affiliate_footer_content|parking_check_in_column|booking_parking_check_in|parking_arrival|reservation_guid_session|booking_bay_parking|reservation_parking_as_add_on_product_record
								|pay_as_you_go_refund|pay_as_you_go_transaction_attempt|product_grace_settings|product_cancel_waiver_pricing|ancillary_bundle.*|ab_shop_product_config_lounge|reservation_basket_simple_ticket_bundle_item|reservation_basket_lounge_bundle_item
								|shop_order_item_bundle_simple_ticket|shop_order_item_bundle_lounge|booking_bundle_breakdown|reservation_basket_bundle_booking|site_invoice_api_configuration|data_import_summary|partial_payment_amount|booking_bundle_placeholders|manual_refunds|loyalty_tier_setting_history|featured_product_appearance
								|payg_contact_barcode|google_payg_passkit_setting|apple_payg_passkit_setting|subscription_product_car_park|site_payg_setting|site_payg_setting_affiliate|quotas_parking_occupancy_hour|quotas_parking_occupancy_day
								|api_barrier_booking_sent|subscription_pass_kit_setting|subscription_google_pass_setting|rms_product|product_additional_config|additional_product_appearance|contact_loyalty_setting|site_availability_api_configuration_product|ab_shop_product_availability_rules|ab_affiliates_ancillary_commissions|ab_affiliates_commissions
 								|mfa_configuration|mfa_configuration_site|lounge_purchase_history|mfa_configuration|mfa_configuration_site|integration_configuration|integration_configuration_product|integration_configuration_subscription_product|subscription_contact_membership|barrier_booking_arbitrary_refund|affiliate_priority_state|api_barrier_booking_third_party_sent
								|customer_data_settings|payment_step_fields_subscription_products|integration_configuration_carpark_mapping|integration_configuration_reviews
								|quotas_subscription|quotas_subscription_product|subscription_product_terms|rfid_bookings|site_license_plate_validation_rule|site_country_validation_rule|pay_as_you_go_failed_payment_vehicle|vehicle_rfid_history|affiliate_parking_booking_fee_configuration|product_active_booking_amend_rules
								|car_park_unique_link|product_fees_taxes_configuration|product_draft_external_code|contact_pending_marketing_opt_in|affiliate_vat_validation_settings|product_parking_booking_fee_configuration|featured_product_constraint|ancillary_featured_appearance
							</includes>
							<excludes>lp_.*|subscription_rep.*</excludes>
							<inputSchema>kmp_advancebooker</inputSchema>
							<outputSchemaToDefault>true</outputSchemaToDefault>
							<customTypes>
								<customType>
									<name>LocalDateTime</name>
									<type>java.time.LocalDateTime</type>
									<converter>com.kmp.aeroparker.model.db.jooq.converters.TimestampToLocalDateTimeConverter</converter>
								</customType>
								<customType>
									<name>VarcharToBigDecimal</name>
									<type>java.math.BigDecimal</type>
									<converter>com.kmp.aeroparker.model.db.jooq.converters.VarcharToBigDecimalConverter</converter>
								</customType>
								<customType>
									<name>IntegerToBoolean</name>
									<type>java.lang.Boolean</type>
									<converter>com.kmp.aeroparker.model.db.jooq.converters.IntegerToBooleanConverter</converter>
								</customType>
                                <customType>
                                    <name>LongToBoolean</name>
                                    <type>java.lang.Boolean</type>
                                    <converter>com.kmp.aeroparker.model.db.jooq.converters.LongToBooleanConverter</converter>
                                </customType>
								<customType>
									<name>DoubleToInteger</name>
									<type>java.lang.Integer</type>
									<converter>com.kmp.aeroparker.model.db.jooq.converters.DoubleToIntegerConverter</converter>
								</customType>
								<customType>
									<name>DateToLocalDate</name>
									<type>java.time.LocalDate </type>
									<converter>com.kmp.aeroparker.model.db.jooq.converters.SqlDateToLocalDateConverter</converter>
								</customType>
							</customTypes>
							<forcedTypes>
								<forcedType>
									<name>LocalDateTime</name>
									<expression>.*</expression>
									<!-- Must be lower case. Many a tear was shed trying to figure this 
										out. -->
									<types>timestamp</types>
								</forcedType>
								<forcedType>
									<name>LocalDateTime</name>
									<expression>.*</expression>
									<!-- Must be lower case. Many a tear was shed trying to figure this 
										out. -->
									<types>datetime</types>
								</forcedType>
								<forcedType>
									<name>DateToLocalDate</name>
									<expression>
									<!-- Must be lower case. Many a tear was shed trying to figure this 
										out. -->
										.*subscription_booking_ticket.start_date|.*subscription_booking_ticket.end_date
									</expression>
									<types>date</types>
								</forcedType>
								<forcedType>
									<name>VarcharToBigDecimal</name>
									<expression>
										.*loyalty_settings.pointsPerCurrencyUnit|.*loyalty_tiers.pointThreshold|.*promotions_loyalty.pointsCost|
										.*contacts_loyalty_points.totalPoints|.*contacts_loyalty_transactions.points|.*loyalty_tier_setting_history.point_threshold
									</expression>
									<types>varchar</types>
								</forcedType>
								<forcedType>
									<name>IntegerToBoolean</name>
									<expression>
										.*contacts_loyalty_transactions.cancelled|.*categories.isSite|.*payment_step_fields_group.all_affiliates|.*contacts_loyalty_transactions.pending|
										.*parking_arrival.checked_in|.*parking_arrival.checked_out
									</expression>
									<types>int</types>
								</forcedType>
                                <forcedType>
                                    <name>LongToBoolean</name>
                                    <expression>
                                        .*parking_arrival.checked_in|.*parking_arrival.checked_out
                                    </expression>
                                    <types>bigint</types>
                                </forcedType>
								<forcedType>
									<name>DoubleToInteger</name>
									<expression>
										.*ancillary_placeholders.primary_product_id
									</expression>
									<types>double</types>
								</forcedType>
							</forcedTypes>
						</database>
						<strategy>
							<!-- Strategies cannot be in the same project as the generated code, 
								must be in another project that is added as a dependency -->
							<name>com.kmp.aeroparker.model.db.jooq.generators.CleanPojoAndDaoGeneratorStrategy</name>
						</strategy>
						<generate>
							<deprecated>false</deprecated>
							<pojos>true</pojos>
							<daos>true</daos>
						</generate>
						<target>
							<packageName>com.kmp.aeroparker.model.parking.db</packageName>
							<directory>src/main/generated</directory>
						</target>
					</generator>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.0.0</version>
				<executions>
					<execution>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>src/main/generated</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.0.0</version>
				<configuration>
					<filesets>
						<fileset>
							<directory>src/main/generated</directory>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<!--This plugin's configuration is used to store Eclipse m2e settings 
					only. It has no influence on the Maven build itself. -->
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.jooq</groupId>
										<artifactId>
											jooq-codegen-maven
										</artifactId>
										<versionRange>
											[3.4.5,)
										</versionRange>
										<goals>
											<goal>generate</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<reporting>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-project-info-reports-plugin</artifactId>
				<configuration>
					<dependencyLocationsEnabled>false</dependencyLocationsEnabled>
				</configuration>
			</plugin>
		</plugins>
	</reporting>
</project>