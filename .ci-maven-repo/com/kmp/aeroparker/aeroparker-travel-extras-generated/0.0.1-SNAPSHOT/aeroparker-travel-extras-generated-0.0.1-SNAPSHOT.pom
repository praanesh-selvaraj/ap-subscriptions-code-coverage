<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<parent>
		<groupId>com.kmp.aeroparker</groupId>
		<artifactId>aeroparker-build</artifactId>
		<version>1.0.0</version>
		<relativePath>../aeroparker-build/pom.xml</relativePath>
	</parent>

	<artifactId>aeroparker-travel-extras-generated</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>Travel Extras - Generated</name>
	<url>http://www.aeroparker.com</url>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<aeroparker-version>1.0.0</aeroparker-version>
		<aeroparker-snapshot-version>0.0.1-SNAPSHOT</aeroparker-snapshot-version>
		<checkstyle.version>2.17</checkstyle.version>
		<jooq-version>3.10.8</jooq-version>
	</properties>

	<distributionManagement>
		<repository>
			<id>central</id>
			<name>releases</name>
			<url>${url.ext-release-local}</url>
		</repository>
		<snapshotRepository>
			<id>snapshots</id>
			<name>snapshots</name>
			<url>${url.ext-snapshot-local}</url>
		</snapshotRepository>
	</distributionManagement>

	<dependencies>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-common-db</artifactId>
			<version>${aeroparker-snapshot-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-common-test</artifactId>
			<version>${aeroparker-snapshot-version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>aeroparker-travel-extras-generated</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>2.1</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
			<plugin>
				<!-- Specify the maven code generator plugin -->
				<groupId>org.jooq</groupId>
				<artifactId>jooq-codegen-maven</artifactId>
				<version>${jooq-version}</version>
				<!-- The plugin should hook into the generate goal -->
				<executions>
					<execution>
						<goals>
							<goal>generate</goal>
						</goals>
					</execution>
				</executions>
				<!-- Manage the plugin's dependency. In this example, we'll use a PostgreSQL 
					database -->
				<dependencies>
					<dependency>
						<groupId>mysql</groupId>
						<artifactId>mysql-connector-java</artifactId>
						<version>8.0.33</version>
					</dependency>
					<dependency>
						<groupId>com.kmp.aeroparker</groupId>
						<artifactId>aeroparker-common-db</artifactId>
						<version>${aeroparker-snapshot-version}</version>
					</dependency>
				</dependencies>
				<!-- Specify the plugin configuration. The configuration format is the 
					same as for the standalone code generator -->
				<configuration>
					<jdbc>
						<driver>com.mysql.jdbc.Driver</driver>
						<!-- These should be set in your active profile in the maven settings.xml -->
						<url>${jdbc.url}</url>
						<user>${jdbc.user}</user>
						<password>${jdbc.password}</password>
					</jdbc>
					<generator>
						<name>org.jooq.util.JavaGenerator</name>
						<database>
							<name>org.jooq.util.mysql.MySQLDatabase</name>
							<includes>
								ab_consolidator_.*|ab_shop_order_.*|ab_shop_orders.*|ab_shop_product_appearance|ab_shop_product_extra.*|ab_shop_products*|consolidator_.*|ancillary_extras_by_shop_order_id
								|ancillary_ticket_template|ab_shop_order_barcode|shop_order_barcode_values|lounge_orders|lounge_quotas_validity_periods|get_ancillary_.*|ancillary_group.*|site_ancillary_.*
								|shop_order_third_party_barcode_values|lounge_arrival|shop_product_extra_variant_archive
								|my_account_shop_order|shop_order_lounge_check_in|lounge_arrival_check_in|lounge_check_in_columns
								|ancillary_directions|shop_order_price_reduction|shop_order_call_centre_user|multi_lounge_display
								|ancillary_ancillary_extra|ancillary_ticket_grace_period|ab_affiliates|walk_in_shop_order
								|ancillary_ticket_template_log|multi_airport_display|shop_order_passenger|api_reserved_ancillary_ticket
								|ancillary_extra_affiliates|shop_order_third_party_barcode_counter|shop_product_fulfilment|tariff_simple_ticket_price_by_duration|ab_shop_tariffs_simple_ticket|ab_shop_product_availability_ranges
								|shop_product_lead_time_discount|ab_agency_shop_orders|site_ancillary_barcode_configuration_subscription_product|shop_order_custom_value
							</includes>
							<inputSchema>kmp_advancebooker</inputSchema>
							<outputSchemaToDefault>true</outputSchemaToDefault>
							<customTypes>
								<customType>
									<name>StringArray</name>
									<type>java.lang.String[]</type>
									<converter>com.kmp.aeroparker.model.db.jooq.converters.VarcharToStringArrayConverter</converter>
								</customType>
								<customType>
									<name>VarcharToBigDecimal</name>
									<type>java.math.BigDecimal</type>
									<converter>com.kmp.aeroparker.model.db.jooq.converters.VarcharToBigDecimalConverter</converter>
								</customType>
								<customType>
									<name>IntegerToBoolean</name>
									<type>java.lang.Boolean</type>
									<converter>com.kmp.aeroparker.model.db.jooq.converters.IntegerToBooleanConverter</converter>
								</customType>
                                <customType>
                                    <name>LongToBoolean</name>
                                    <type>java.lang.Boolean</type>
                                    <converter>com.kmp.aeroparker.model.db.jooq.converters.LongToBooleanConverter</converter>
                                </customType>
								<customType>
									<name>ShopProductModuleTypeEnum</name>
									<type>com.kmp.aeroparker.model.travelextras.jooq.enums.ShopProductModuleTypeEnum</type>
									<converter>com.kmp.aeroparker.model.travelextras.jooq.converters.ShopProductModuleTypeEnumConverter</converter>
								</customType>
								<customType>
									<name>LocalDateTime</name>
									<type>java.time.LocalDateTime</type>
									<converter>com.kmp.aeroparker.model.db.jooq.converters.TimestampToLocalDateTimeConverter</converter>
								</customType>
							</customTypes>
							<forcedTypes>
								<forcedType>
									<name>LocalDateTime</name>
									<expression>
										.*lounge_arrival.arrival_date_time|.*shop_order_lounge_check_in.arrival_date_time|.*lounge_arrival.check_out_date_time
										|.*shop_product_fulfilment.created|.*shop_product_fulfilment.updated
									</expression>
									<!-- Must be lower case. Many a tear was shed trying to figure this 
										out. -->
									<types>datetime</types>
								</forcedType>
                                <forcedType>
                                    <name>LocalDateTime</name>
                                    <expression>
                                        .*shop_product_fulfilment.created|.*shop_product_fulfilment.updated
                                    </expression>
                                    <!-- Must be lower case. Many a tear was shed trying to figure this 
                                        out. -->
                                    <types>timestamp</types>
                                </forcedType>
								<forcedType>
									<name>StringArray</name>
									<expression>.*ab_shop_products.sellingLocationShopNames</expression>
									<types>varchar</types>
								</forcedType>
								<forcedType>
									<name>VarcharToBigDecimal</name>
									<expression>
										.*ab_shop_products.minimumHoursAmend|.*ab_shop_products.minimumHoursCancel|
										.*ab_shop_product_extra_variant.price|.*ab_shop_order_items_shop_product_extras_variants.unit_price
									</expression>
									<types>varchar</types>
								</forcedType>
								<forcedType>
									<name>IntegerToBoolean</name>
									<expression>
										.*ab_shop_products.sellingLocationIndividual|.*ab_shop_products.sellingLocationAdditionalCp|
										.*ab_shop_products.sellingLocationTakePaymentStep|.*ab_shop_products.sellingLocationAdditionalShop|
										.*ab_shop_products.sellingLocationMultiPurchase|.*ab_shop_products.sellingLocationAdditionalMultiPurchase|
										.*ab_shop_products.enabled|.*ab_shop_products.hidden|.*ab_shop_products.barcodingEnabled|
										.*ab_shop_products.sellingLocationDetailsStep|.*lounge_arrival.checked_in|.*lounge_arrival.checked_out
									</expression>
									<types>int</types>
								</forcedType>
                                <forcedType>
                                    <name>LongToBoolean</name>
                                    <expression>
                                        .*lounge_arrival.checked_in|.*lounge_arrival.checked_out
                                    </expression>
                                    <types>bigint</types>
                                </forcedType>
								<forcedType>
									<name>ShopProductModuleTypeEnum</name>
									<expression>.*ab_shop_products.moduleId</expression>
									<types>int</types>
								</forcedType>
							</forcedTypes>
						</database>
						<strategy>
							<!-- Strategies cannot be in the same project as the generated code, 
								must be in another project that is added as a dependency -->
							<name>com.kmp.aeroparker.model.db.jooq.generators.CleanPojoAndDaoGeneratorStrategy</name>
						</strategy>
						<generate>
							<deprecated>false</deprecated>
							<pojos>true</pojos>
							<daos>true</daos>
						</generate>
						<target>
							<packageName>com.kmp.aeroparker.model.travelextras.jooq</packageName>
							<directory>src/main/generated</directory>
						</target>
					</generator>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.0.0</version>
				<executions>
					<execution>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>src/main/generated</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.0.0</version>
				<configuration>
					<filesets>
						<fileset>
							<directory>src/main/generated</directory>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<!--This plugin's configuration is used to store Eclipse m2e settings 
					only. It has no influence on the Maven build itself. -->
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.jooq</groupId>
										<artifactId>
											jooq-codegen-maven
										</artifactId>
										<versionRange>
											[3.4.5,)
										</versionRange>
										<goals>
											<goal>generate</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<reporting>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-project-info-reports-plugin</artifactId>
				<configuration>
					<dependencyLocationsEnabled>false</dependencyLocationsEnabled>
				</configuration>
			</plugin>
		</plugins>
	</reporting>
</project>