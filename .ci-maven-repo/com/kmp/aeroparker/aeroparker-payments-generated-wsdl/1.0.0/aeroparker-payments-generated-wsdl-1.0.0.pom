<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.kmp.aeroparker</groupId>
		<artifactId>aeroparker-build</artifactId>
		<version>1.0.0</version>
		<relativePath>../aeroparker-build/pom.xml</relativePath>
	</parent>

	<artifactId>aeroparker-payments-generated-wsdl</artifactId>
	<packaging>jar</packaging>

	<name>aeroparker-payments-generated-wsdl</name>
	<url>http://maven.apache.org</url>

	<distributionManagement>
		<repository>
			<id>central</id>
			<name>releases</name>
			<url>${url.ext-release-local}</url>
		</repository>
		<snapshotRepository>
			<id>snapshots</id>
			<name>snapshots</name>
			<url>${url.ext-snapshot-local}</url>
		</snapshotRepository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<cxf-version>3.1.0</cxf-version>
		<axis2-version>1.7.7</axis2-version>
		<wsdl2java.phase>none</wsdl2java.phase>
		<wsdl2code.phase>generate-sources</wsdl2code.phase>
		<ems.wsdl>wsdl/ems/order_1.wsdl</ems.wsdl>
		<checkstyle.skip>true</checkstyle.skip>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.apache.axis</groupId>
			<artifactId>axis</artifactId>
			<version>1.4</version>
		</dependency>
		<dependency>
			<groupId>javax.xml</groupId>
			<artifactId>jaxrpc-api</artifactId>
			<version>1.1</version>
		</dependency>
		<dependency>
			<groupId>org.apache.axis2</groupId>
			<artifactId>axis2-adb</artifactId>
			<version>${axis2-version}</version>
		</dependency>
	</dependencies>

	<build>
		<finalName>aeroparker-payments-generated-wsdl</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.6.1</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.0.0</version>
				<executions>
					<execution>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>src/main/generated</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.0.0</version>
				<configuration>
					<filesets>
						<fileset>
							<directory>src/main/generated/com/kmp/aeroparker/payments/wsdl/p24</directory>
						</fileset>
						<fileset>
							<directory>src/main/generated/com/kmp/aeroparker/payments/wsdl/ems/order</directory>
						</fileset>
						<fileset>
							<directory>target/</directory>
							<includes>
								<include>p24sandbox.wsdl</include>
								<include>p24secure.wsdl</include>
							</includes>
						</fileset>
					</filesets>
				</configuration>
				<executions>
					<execution>
						<id>auto-clean</id>
						<phase>initialize</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>axistools-maven-plugin</artifactId>
				<version>1.4</version>
				<configuration>
					<sourceDirectory>${basedir}/src/main/resources/wsdl/</sourceDirectory>
					<outputDirectory>src/main/generated</outputDirectory>
					<timeout>15</timeout>
					<subPackageByFileName>false</subPackageByFileName>
				</configuration>
				<executions>
					<!-- Each execution has it's own id -->
					<execution>
						<id>1</id>
						<configuration>
							<wsdlFiles>
								<wsdlFile>p24${p24.soapservice}.wsdl</wsdlFile>
							</wsdlFiles>
							<packageSpace>com.kmp.aeroparker.payments.wsdl.p24</packageSpace>
						</configuration>
						<goals>
							<goal>wsdl2java</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.axis2</groupId>
				<artifactId>axis2-wsdl2code-maven-plugin</artifactId>
				<version>${axis2-version}</version>
				<executions>
					<execution>
						<id>demo-advam-session</id>
						<phase>${wsdl2java.phase}</phase>
						<goals>
							<goal>wsdl2code</goal>
						</goals>
						<configuration>
							<packageName>com.kmp.aeroparker.payments.wsdl.advam.session.demo</packageName>
							<outputDirectory>src/main/generated</outputDirectory>
							<wsdlFile>https://demo-webbank.advam.com/session/ws/V1/AdvamWebBankSession.wsdl</wsdlFile>
							<flattenFiles>true</flattenFiles>
						</configuration>
					</execution>
					<execution>
						<id>demo-advam-stored-token-primary</id>
						<phase>${wsdl2java.phase}</phase>
						<goals>
							<goal>wsdl2code</goal>
						</goals>
						<configuration>
							<packageName>com.kmp.aeroparker.payments.wsdl.advam.storedtoken.demo.primary</packageName>
							<outputDirectory>src/main/generated</outputDirectory>
							<wsdlFile>https://demo-gateway.advam.com/stored_token/V1/StoredToken.wsdl</wsdlFile>
							<flattenFiles>true</flattenFiles>
						</configuration>
					</execution>
					<execution>
						<id>demo-advam-stored-token-secondary</id>
						<phase>${wsdl2java.phase}</phase>
						<goals>
							<goal>wsdl2code</goal>
						</goals>
						<configuration>
							<packageName>com.kmp.aeroparker.payments.wsdl.advam.storedtoken.demo.secondary</packageName>
							<outputDirectory>src/main/generated</outputDirectory>
							<wsdlFile>https://demo-gateway2.advam.com/stored_token/V1/StoredToken.wsdl</wsdlFile>
							<flattenFiles>true</flattenFiles>
						</configuration>
					</execution>
					<execution>
						<id>live-advam-session-primary</id>
						<phase>${wsdl2java.phase}</phase>
						<goals>
							<goal>wsdl2code</goal>
						</goals>
						<configuration>
							<packageName>com.kmp.aeroparker.payments.wsdl.advam.session.live.primary</packageName>
							<outputDirectory>src/main/generated</outputDirectory>
							<wsdlFile>https://webbank.advam.com/session/ws/V1/AdvamWebBankSession.wsdl</wsdlFile>
							<flattenFiles>true</flattenFiles>
						</configuration>
					</execution>
					<execution>
						<id>live-advam-session-secondary</id>
						<phase>${wsdl2java.phase}</phase>
						<goals>
							<goal>wsdl2code</goal>
						</goals>
						<configuration>
							<packageName>com.kmp.aeroparker.payments.wsdl.advam.session.live.secondary</packageName>
							<outputDirectory>src/main/generated</outputDirectory>
							<wsdlFile>https://webbank2.advam.com/session/ws/V1/AdvamWebBankSession.wsdl</wsdlFile>
							<flattenFiles>true</flattenFiles>
						</configuration>
					</execution>
					<execution>
						<id>live-advam-stored-token-primary</id>
						<phase>${wsdl2java.phase}</phase>
						<goals>
							<goal>wsdl2code</goal>
						</goals>
						<configuration>
							<packageName>com.kmp.aeroparker.payments.wsdl.advam.storedtoken.live.primary</packageName>
							<outputDirectory>src/main/generated</outputDirectory>
							<wsdlFile>https://gateway.advam.com/stored_token/V1/StoredToken.wsdl</wsdlFile>
							<flattenFiles>true</flattenFiles>
						</configuration>
					</execution>
					<execution>
						<id>live-advam-stored-token-secondary</id>
						<phase>${wsdl2java.phase}</phase>
						<goals>
							<goal>wsdl2code</goal>
						</goals>
						<configuration>
							<packageName>com.kmp.aeroparker.payments.wsdl.advam.storedtoken.live.secondary</packageName>
							<outputDirectory>src/main/generated</outputDirectory>
							<wsdlFile>https://gateway2.advam.com/stored_token/V1/StoredToken.wsdl</wsdlFile>
							<flattenFiles>true</flattenFiles>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.cxf</groupId>
				<artifactId>cxf-codegen-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>ems-initialise-service</id>
						<configuration>
							<sourceRoot>${basedir}/src/main/generated/</sourceRoot>
							<includes>
								<include>src/main/resources/${ems.wsdl}</include>
							</includes>
							<wsdlOptions>
								<wsdlOption>
									<wsdl>src/main/resources/${ems.wsdl}</wsdl>
									<wsdlLocation>classpath:${ems.wsdl}</wsdlLocation>
									<extraargs>
										<extraarg>-p</extraarg>
										<extraarg>com.kmp.aeroparker.payments.wsdl.ems.order</extraarg>
									</extraargs>
								</wsdlOption>
							</wsdlOptions>
						</configuration>
						<goals>
							<goal>wsdl2java</goal>
						</goals>
					</execution>
					<execution>
						<id>three-c-initialise-service</id>
						<phase>${wsdl2code.phase}</phase>
						<configuration>
							<sourceRoot>${basedir}/src/main/generated/</sourceRoot>
							<includes>
								<include>https://${threec.soapservicedomain}/ipage/Service/_2006_05_v1_0_1/initialiseservice.asmx?WSDL</include>
								<include>https://${threec.soapservicedomain}/mxg/service/_2011_02_v5_1_0/Pay.asmx?WSDL</include>
								<include>https://${threec.soapservicedomain}/mxg/service/_2011_02_v5_1_0/Authorise.asmx?WSDL</include>
							</includes>
							<wsdlOptions>
								<wsdlOption>
									<wsdl>https://${threec.soapservicedomain}/ipage/Service/_2006_05_v1_0_1/initialiseservice.asmx?WSDL</wsdl>
									<extraargs>
										<extraarg>-p</extraarg>
										<extraarg>com.kmp.aeroparker.payments.wsdl.threec.initialise</extraarg>
									</extraargs>
								</wsdlOption>
								<wsdlOption>
									<wsdl>https://${threec.soapservicedomain}/mxg/service/_2011_02_v5_1_0/Pay.asmx?WSDL</wsdl>
									<extraargs>
										<extraarg>-p</extraarg>
										<extraarg>com.kmp.aeroparker.payments.wsdl.threec.pay</extraarg>
									</extraargs>
								</wsdlOption>
								<wsdlOption>
									<wsdl>https://${threec.soapservicedomain}/mxg/service/_2011_02_v5_1_0/Authorise.asmx?WSDL</wsdl>
									<extraargs>
										<extraarg>-p</extraarg>
										<extraarg>com.kmp.aeroparker.payments.wsdl.threec.authorise</extraarg>
									</extraargs>
								</wsdlOption>
							</wsdlOptions>
						</configuration>
						<goals>
							<goal>wsdl2java</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>jaxb2-maven-plugin</artifactId>
				<version>2.4</version>
				<executions>
					<execution>
						<id>xjc</id>
						<goals>
							<goal>xjc</goal>
						</goals>
						<configuration>
							<skipXjc>true</skipXjc>
							<sources>
								<source>${basedir}/src/main/resources/xsd/wirecardpayment.xsd</source>
							</sources>
							<packageName>com.kmp.aeroparker.payments.xml.wirecard.model</packageName>
							<outputDirectory>${user.dir}/src/main/generated</outputDirectory>
							<clearOutputDir>false</clearOutputDir>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<!--This plugin's configuration is used to store Eclipse m2e settings 
					only. It has no influence on the Maven build itself. -->
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.codehaus.mojo
										</groupId>
										<artifactId>
											axistools-maven-plugin
										</artifactId>
										<versionRange>
											[1.4,)
										</versionRange>
										<goals>
											<goal>wsdl2java</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore />
									</action>
								</pluginExecution>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.apache.maven.plugins</groupId>
										<artifactId>maven-clean-plugin</artifactId>
										<versionRange>
											[3,)
										</versionRange>
										<goals>
											<goal>clean</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore />
									</action>
								</pluginExecution>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.apache.cxf</groupId>
										<artifactId>cxf-codegen-plugin</artifactId>
										<versionRange>
											[3.1.0,)
										</versionRange>
										<goals>
											<goal>wsdl2java</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore />
									</action>
								</pluginExecution>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.apache.axis2</groupId>
										<artifactId>axis2-wsdl2code-maven-plugin</artifactId>
										<versionRange>
											[1.7.7,)
										</versionRange>
										<goals>
											<goal>wsdl2code</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore />
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<reporting>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-project-info-reports-plugin</artifactId>
				<configuration>
					<dependencyLocationsEnabled>false</dependencyLocationsEnabled>
				</configuration>
			</plugin>
		</plugins>
	</reporting>
</project>