<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.kmp.aeroparker</groupId>
		<artifactId>aeroparker-build</artifactId>
		<version>1.0.0</version>
		<relativePath>../aeroparker-build/pom.xml</relativePath>
	</parent>

	<artifactId>aeroparker-payments-generated</artifactId>
	<packaging>jar</packaging>

	<name>aeroparker-payments-generated</name>
	<url>http://maven.apache.org</url>

	<distributionManagement>
		<repository>
			<id>central</id>
			<name>releases</name>
			<url>${url.ext-release-local}</url>
		</repository>
		<snapshotRepository>
			<id>snapshots</id>
			<name>snapshots</name>
			<url>${url.ext-snapshot-local}</url>
		</snapshotRepository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<aeroparker-snapshot-version>0.0.1-SNAPSHOT</aeroparker-snapshot-version>
		<aeroparker-version>1.0.0</aeroparker-version>
		<jooq-version>3.10.8</jooq-version>
		<swagger-annotations-version>2.2.9</swagger-annotations-version>
		<swagger-version>1.6.10</swagger-version>
		<swagger-codegen-version>2.4.31</swagger-codegen-version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-common-db</artifactId>
			<version>${aeroparker-snapshot-version}</version>
		</dependency>
		<dependency>
			<groupId>commons-discovery</groupId>
			<artifactId>commons-discovery</artifactId>
			<version>0.5</version>
		</dependency>
		<dependency>
			<groupId>io.swagger.core.v3</groupId>
			<artifactId>swagger-annotations</artifactId>
			<version>${swagger-annotations-version}</version>
		</dependency>
		<dependency>
			<groupId>io.swagger</groupId>
			<artifactId>swagger-core</artifactId>
			<version>${swagger-version}</version>
		</dependency>
		<dependency>
			<groupId>io.swagger</groupId>
			<artifactId>swagger-jersey2-jaxrs</artifactId>
			<version>${swagger-version}</version>
		</dependency>
	</dependencies>

	<build>
		<finalName>aeroparker-payments-generated</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.6.1</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>io.swagger</groupId>
				<artifactId>swagger-codegen-maven-plugin</artifactId>
				<version>${swagger-codegen-version}</version>
				<executions>
					<execution>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${basedir}/src/test/resources/payment-adapter.swagger.json</inputSpec>
							<language>java</language>
							<output>${basedir}</output>
							<generateApis>false</generateApis>
							<generateSupportingFiles>false</generateSupportingFiles>
							<generateModels>true</generateModels>
							<generateModelDocumentation>false</generateModelDocumentation>
							<withXml>false</withXml>
							<configOptions>
								<sourceFolder>src/gen/java</sourceFolder>
								<dateLibrary>java8-localdatetime</dateLibrary>
								<library>jersey2</library>
								<modelPackage>io.swagger.model</modelPackage>
								<serializableModel>true</serializableModel>
							</configOptions>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- Specify the maven code generator plugin -->
				<groupId>org.jooq</groupId>
				<artifactId>jooq-codegen-maven</artifactId>
				<version>${jooq-version}</version>
				<!-- The plugin should hook into the generate goal -->
				<executions>
					<execution>
						<goals>
							<goal>generate</goal>
						</goals>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>mysql</groupId>
						<artifactId>mysql-connector-java</artifactId>
						<version>8.0.33</version>
					</dependency>
				</dependencies>
				<configuration>
					<jdbc>
						<driver>com.mysql.jdbc.Driver</driver>
						<!-- These should be set in your active profile in the maven settings.xml -->
						<url>${jdbc.url}</url>
						<user>${jdbc.user}</user>
						<password>${jdbc.password}</password>
					</jdbc>
					<generator>
						<name>org.jooq.util.DefaultGenerator</name>
						<database>
							<name>org.jooq.util.mysql.MySQLDatabase</name>
							<includes>payments.*|refunds.*|saved_card.*|wirecard.*|selected_payment_gateway.*|call_centre_user_refund|agency_user_refund|refund_information_view|
									  payment_gateways_affiliate_ogone_alias_usage|payment_gateways_car_park_ogone_alias_usage|payment_gateways_ogone_alias_usage|currencies|payment_invoice|
									  payment_breakdown|refund_breakdown|payeezy_guid_tracking|concardis_redirect|payone.*|ab_contacts|flex_microform.*|klix_session|
									  concardis_status|partial_payments|windcave.*|partial_payment_amount|nets_payment_method|nmi_status|partial_payment_history|
									  partial_refund_history|nic_payment_guid|payment_breakdown_on_price_decrease|partial_refunds_status|payment_token_session|
									  computop_payment_request|computop_payment_response|refund_token_session|datatrans_reservation|datatrans_redirect|query_pending_payment|partial_payment_version|
									  bankart_token_reservation|bankart_refund|payment_identifier|stripe_contact|nets_number_of_goods|payone_v2_hosted_checkout_session|payone_v2_response|
									  nets_payment_transaction_id|advam_migrated_token|worldline_hosted_checkout_session|worldline_response|pelecard_session|payment_transaction|payment_guid_session|
									  refund_partial_allocation|stripe_webhook_data|transaction_reservation_guid|adyen_session|adyen_refund_status
							</includes>
							<excludes />
							<inputSchema>kmp_advancebooker</inputSchema>
							<outputSchemaToDefault>true</outputSchemaToDefault>
							<customTypes>
								<customType>
									<name>LocalDateTime</name>
									<type>java.time.LocalDateTime</type>
									<converter>com.kmp.aeroparker.model.db.jooq.converters.TimestampToLocalDateTimeConverter</converter>
								</customType>
								<customType>
									<name>VarcharToBigDecimal</name>
									<type>java.math.BigDecimal</type>
									<converter>com.kmp.aeroparker.model.db.jooq.converters.VarcharToBigDecimalConverter</converter>
								</customType>
							</customTypes>
							<forcedTypes>
								<forcedType>
									<name>LocalDateTime</name>
									<expression>.*payments_heartland_response.created|.*payments_heartland_summary_response.response_date|.*partial_payments.created
										|.*query_pending_payment.created|.*query_pending_payment.updated|.*query_pending_payment.arrival_date|.*query_pending_payment.return_date
										|.*pelecard_session.created|.*stripe_webhook_data.created
									</expression>
									<!-- Must be lower case. Many a tear was shed trying to figure this 
										out. -->
									<types>datetime</types>
								</forcedType>
								<forcedType>
									<name>VarcharToBigDecimal</name>
									<expression>
										.*partial_payments.amount|.*partial_payments.amount_refunded|.*nic_payment_guid.amount
									</expression>
									<types>varchar</types>
								</forcedType>
							</forcedTypes>
						</database>

						<strategy>
							<!-- Strategies cannot be in the same project as the generated code, 
								must be in another project that is added as a dependency -->
							<name>com.kmp.aeroparker.model.db.jooq.generators.CleanPojoAndDaoGeneratorStrategy</name>
						</strategy>
						<generate>
							<deprecated>false</deprecated>
							<pojos>true</pojos>
							<daos>true</daos>
						</generate>
						<target>
							<packageName>com.kmp.aeroparker.payments</packageName>
							<directory>src/main/generated</directory>
						</target>
					</generator>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.0.0</version>
				<executions>
					<execution>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>src/main/generated</source>
								<source>src/gen/java</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.0.0</version>
				<configuration>
					<filesets>
						<fileset>
							<directory>src/main/generated</directory>
						</fileset>
						<fileset>
							<directory>src/gen/java</directory>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<!--This plugin's configuration is used to store Eclipse m2e settings 
					only. It has no influence on the Maven build itself. -->
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>io.swagger</groupId>
										<artifactId>swagger-codegen-maven-plugin</artifactId>
										<versionRange>[${swagger-codegen-version},)</versionRange>
										<goals>
											<goal>generate</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<execute />
									</action>
								</pluginExecution>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.jooq</groupId>
										<artifactId>
											jooq-codegen-maven
										</artifactId>
										<versionRange>
											[3.4.5,)
										</versionRange>
										<goals>
											<goal>generate</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore />
									</action>
								</pluginExecution>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.apache.maven.plugins</groupId>
										<artifactId>maven-clean-plugin</artifactId>
										<versionRange>
											[3,)
										</versionRange>
										<goals>
											<goal>clean</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore />
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.openapitools</groupId>
					<artifactId>openapi-generator-maven-plugin</artifactId>
					<version>6.5.0</version>
					<configuration>
						<generatorName>spring</generatorName>
						<output>${basedir}</output>
						<generateApis>false</generateApis>
						<generateApiTests>false</generateApiTests>
						<generateSupportingFiles>false</generateSupportingFiles>
						<generateModels>true</generateModels>
						<generateModelTests>false</generateModelTests>
						<generateModelDocumentation>false</generateModelDocumentation>
						<withXml>false</withXml>
						<configOptions>
							<sourceFolder>src/gen/java</sourceFolder>
							<dateLibrary>java8-localdatetime</dateLibrary>
							<library>spring-boot</library>
							<modelPackage>org.openapitools.model</modelPackage>
							<serializableModel>true</serializableModel>
						</configOptions>
						<skipValidateSpec>true</skipValidateSpec>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<reporting>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-project-info-reports-plugin</artifactId>
				<configuration>
					<dependencyLocationsEnabled>false</dependencyLocationsEnabled>
				</configuration>
			</plugin>
		</plugins>
	</reporting>
</project>
