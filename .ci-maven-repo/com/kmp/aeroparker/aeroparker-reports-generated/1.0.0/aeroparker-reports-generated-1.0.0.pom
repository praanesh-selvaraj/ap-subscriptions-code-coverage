<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<parent>
		<groupId>com.kmp.aeroparker</groupId>
		<artifactId>aeroparker-report-generator-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../aeroparker-report-generator-parent/pom.xml</relativePath>
	</parent>

	<artifactId>aeroparker-reports-generated</artifactId>
	<packaging>jar</packaging>

	<name>aeroparker-reports-generated</name>
	<url>http://maven.apache.org</url>

	<distributionManagement>
		<repository>
			<id>central</id>
			<name>releases</name>
			<url>${url.ext-release-local}</url>
		</repository>
		<snapshotRepository>
			<id>snapshots</id>
			<name>snapshots</name>
			<url>${url.ext-snapshot-local}</url>
		</snapshotRepository>
	</distributionManagement>

  	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<aeroparker-snapshot-version>0.0.1-SNAPSHOT</aeroparker-snapshot-version>
		<aeroparker-version>1.0.0</aeroparker-version>
		<jooq-version>3.10.8</jooq-version>
  	</properties>

  	<dependencies>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-common-db</artifactId>
			<version>${aeroparker-snapshot-version}</version>
		</dependency>
  	</dependencies>
  	
  	<build>
		<finalName>aeroparker-reports-generated</finalName>
		<plugins>
			<plugin>
				<!-- Specify the maven code generator plugin -->
				<groupId>org.jooq</groupId>
				<artifactId>jooq-codegen-maven</artifactId>
				<version>${jooq-version}</version>
				<!-- The plugin should hook into the generate goal -->
				<executions>
					<execution>
						<goals>
							<goal>generate</goal>
						</goals>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>mysql</groupId>
						<artifactId>mysql-connector-java</artifactId>
						<version>8.0.33</version>
					</dependency>
				</dependencies>
				<configuration>
					<jdbc>
						<driver>com.mysql.jdbc.Driver</driver>
						<!-- These should be set in your active profile in the maven settings.xml -->
						<url>${jdbc.url}</url>
						<user>${jdbc.user}</user>
						<password>${jdbc.password}</password>
					</jdbc>
					<generator>
						<name>org.jooq.util.JavaGenerator</name>
						<database>
							<name>org.jooq.util.mysql.MySQLDatabase</name>
							<includes>
								ab_automated_reports.*|temp_automated_reports.*|automated_reports.*|overstay_full_information_view|locations
								|ab_auto_saved_reports_overstay_status|ab_auto_saved_reports|ab_auto_saved_reports_date_range|ab_reports_recipients
								|fixed_report_excluded_sites|ab_sites|admin_user_type|subscription_report.*|locations|voucher_report.*|api_reports_bookings
								|customer_report_site|quick_export_report_site|api_reports_bookings_versions|ab_products|ab_shop_products
								|ab_language_key_translation|ab_lang_sections|swiftparker_report.*|automated_report.*|booking_transaction_details_report
							</includes>
							<excludes></excludes>
							<inputSchema>kmp_advancebooker</inputSchema>
							<outputSchemaToDefault>true</outputSchemaToDefault>
							<customTypes>
								<customType>
									<name>LocalDateTime</name>
									<type>java.time.LocalDateTime</type>
									<converter>com.kmp.aeroparker.model.db.jooq.converters.TimestampToLocalDateTimeConverter</converter>
								</customType>
							</customTypes>
							<forcedTypes>
								<forcedType>
									<name>LocalDateTime</name>
									<expression>.*</expression>
									<!-- Must be lower case. Many a tear was shed trying to figure this out. -->
									<types>timestamp</types>
								</forcedType>
								<forcedType>
									<name>LocalDateTime</name>
									<expression>.*</expression>
									<!-- Must be lower case. Many a tear was shed trying to figure this out. -->
									<types>datetime</types>
								</forcedType>
							</forcedTypes>
						</database>
						<strategy>
							<!-- Strategies cannot be in the same project as the generated code, 
								must be in another project that is added as a dependency -->
							<name>com.kmp.aeroparker.model.db.jooq.generators.CleanPojoAndDaoGeneratorStrategy</name>
						</strategy>
						<generate>
							<deprecated>false</deprecated>
							<pojos>true</pojos>
							<daos>true</daos>
						</generate>
						<target>
							<packageName>com.kmp.aeroparker.automatedreports</packageName>
							<directory>src/main/generated</directory>
						</target>
					</generator>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.0.0</version>
				<executions>
					<execution>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>src/main/generated</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.0.0</version>
				<configuration>
					<filesets>
						<fileset>
							<directory>src/main/generated</directory>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<!--This plugin's configuration is used to store Eclipse m2e settings 
					only. It has no influence on the Maven build itself. -->
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.jooq</groupId>
										<artifactId>
											jooq-codegen-maven
										</artifactId>
										<versionRange>
											[3.4.5,)
										</versionRange>
										<goals>
											<goal>generate</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>