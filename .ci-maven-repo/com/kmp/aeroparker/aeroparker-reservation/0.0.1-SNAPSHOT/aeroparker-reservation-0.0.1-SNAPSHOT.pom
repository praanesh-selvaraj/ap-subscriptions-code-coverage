<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.kmp.aeroparker</groupId>
		<artifactId>aeroparker-build</artifactId>
		<version>1.0.0</version>
		<relativePath>../aeroparker-build/pom.xml</relativePath>
	</parent>

	<artifactId>aeroparker-reservation</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>aeroparker-reservation</name>

	<distributionManagement>
		<repository>
			<id>central</id>
			<name>releases</name>
			<url>${url.ext-release-local}</url>
		</repository>
		<snapshotRepository>
			<id>snapshots</id>
			<name>snapshots</name>
			<url>${url.ext-snapshot-local}</url>
		</snapshotRepository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<aeroparker-snapshot-version>0.0.1-SNAPSHOT</aeroparker-snapshot-version>
		<checkstyle.version>2.17</checkstyle.version>
		<aeroparker-version>1.0.0</aeroparker-version>
		<aeroparker-payments>1.0.0</aeroparker-payments>
		<javax.servlet-api-version>3.1.0</javax.servlet-api-version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-common</artifactId>
			<version>${aeroparker-snapshot-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-reservation-generated</artifactId>
			<version>${aeroparker-snapshot-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-api-reports-sqs-producer</artifactId>
			<version>6.0.1</version>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
			<version>3.12.0</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-common-test</artifactId>
			<version>${aeroparker-snapshot-version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
			<version>${javax.servlet-api-version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>xerces</groupId>
			<artifactId>xercesImpl</artifactId>
			<version>2.12.2</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>aeroparker-reservation</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>2.1</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>