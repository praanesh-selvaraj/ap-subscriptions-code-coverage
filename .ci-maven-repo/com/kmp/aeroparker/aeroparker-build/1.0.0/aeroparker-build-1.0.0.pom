<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.kmp.aeroparker</groupId>
	<artifactId>aeroparker-build</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>

	<name>aeroparker-build</name>
	<url>http://maven.apache.org</url>

	<distributionManagement>
		<repository>
			<id>central</id>
			<name>releases</name>
			<url>${url.ext-release-local}</url>
		</repository>
		<snapshotRepository>
			<id>snapshots</id>
			<name>snapshots</name>
			<url>${url.ext-snapshot-local}</url>
		</snapshotRepository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<checkstyle-maven-plugin.version>3.0.0</checkstyle-maven-plugin.version>
	</properties>
	
	<dependencies>
		<dependency>
			<groupId>javax.mail</groupId>
			<artifactId>mail</artifactId>
			<version>1.4</version>
			<scope>provided</scope>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.google.code.gson</groupId>
				<artifactId>gson</artifactId>
				<version>2.11.0</version> <!-- Force the version -->
			</dependency>
		</dependencies>
	</dependencyManagement>

	<modules>
		<module>../admin</module>
		<module>../aeroparker-active-directory</module>
		<module>../aeroparker-active-directory-admin</module>
		<module>../aeroparker-active-directory-agency</module>
		<module>../aeroparker-active-directory-generated</module>
		<module>../aeroparker-ancillary-quotas</module>
		<module>../aeroparker-ancillary-quotas-admin</module>
		<module>../aeroparker-ancillary-quotas-generated</module>
		<module>../aeroparker-api-external</module>
		<module>../aeroparker-api-generated</module>
		<module>../aeroparker-buckets</module>
		<module>../aeroparker-buckets-admin</module>
		<module>../aeroparker-buckets-generated</module>
		<module>../aeroparker-common</module>
		<module>../aeroparker-common-caching</module>
		<module>../aeroparker-common-db</module>
		<module>../aeroparker-common-generated</module>
		<module>../aeroparker-common-i18n</module>
		<module>../aeroparker-common-test</module>
		<module>../aeroparker-common-utils</module>
		<module>../aeroparker-communicator</module>
		<module>../aeroparker-communicator-generated</module>
		<module>../aeroparker-contacts</module>
		<module>../aeroparker-contacts-generated</module>
		<module>../aeroparker-core</module>
		<module>../aeroparker-crm</module>
		<module>../aeroparker-crm-admin</module>
		<module>../aeroparker-crm-generated</module>
		<module>../aeroparker-instrumentation</module>
		<module>../aeroparker-instrumentation-generated</module>
		<module>../aeroparker-parking-barriers</module>
		<module>../aeroparker-parking-barriers-generated</module>
		<module>../aeroparker-parking-quotas</module>
		<module>../aeroparker-parking-quotas-admin</module>
		<module>../aeroparker-parking-quotas-generated</module>
		<module>../aeroparker-parking-upgrades</module>
		<module>../aeroparker-parking-upgrades-admin</module>
		<module>../aeroparker-parking-upgrades-generated</module>
		<module>../aeroparker-parking-upgrades-shop</module>
		<module>../aeroparker-payments</module>
		<module>../aeroparker-payments-admin</module>
		<module>../aeroparker-payments-agency</module>
		<module>../aeroparker-payments-generated</module>
		<module>../aeroparker-payments-generated-wsdl</module>
		<module>../aeroparker-payments-shop</module>
		<module>../aeroparker-promotions</module>
		<module>../aeroparker-promotions-generated</module>
		<module>../aeroparker-release-notes</module>
		<module>../aeroparker-release-notes-generated</module>
		<module>../aeroparker-reservation</module>
		<module>../aeroparker-reservation-generated</module>
		<module>../aeroparker-social-auth</module>
		<module>../aeroparker-social-auth-generated</module>
		<module>../aeroparker-subscription-quotas-admin</module>
		<module>../aeroparker-subscription-quotas-generated</module>
		<module>../aeroparker-travel-extras</module>
		<module>../aeroparker-travel-extras-generated</module>
		<module>../aeroparker-setup-wizard</module>
		<module>../aeroparker-setup-wizard-admin</module>
		<module>../aeroparker-setup-wizard-generated</module>
		<module>../aeroparker-widget-shop</module>
		<module>../agency</module>
		<module>../aeroparker-aerotimetable-generated</module>
		<module>../reports</module>
		<module>../shared</module>
		<module>../shop</module>
		<module>../webscraper-lib</module>
		<module>../aeroparker-alerts-generated</module>
	</modules>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-deploy-plugin</artifactId>
					<version>2.8.2</version>
					<configuration>
						<deployAtEnd>true</deployAtEnd>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.0.0-M3</version>
					<configuration>
						<skip>${skipUnitTests}</skip>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-failsafe-plugin</artifactId>
					<version>3.0.0-M3</version>
					<executions>
						<execution>
							<id>integration-test</id>
							<goals>
								<goal>integration-test</goal>
								<goal>verify</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
		<extensions>
			<extension>
				<groupId>com.gkatzioura.maven.cloud</groupId>
				<artifactId>s3-storage-wagon</artifactId>
				<version>1.2</version>
			</extension>
		</extensions>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>${checkstyle-maven-plugin.version}</version>
				<dependencies>
					<dependency>
						<groupId>com.puppycrawl.tools</groupId>
						<artifactId>checkstyle</artifactId>
						<version>8.20</version>
					</dependency>
				</dependencies>
				<configuration>
					<configLocation>checkstyle.xml</configLocation>
					<propertyExpansion>samedir=../aeroparker-build</propertyExpansion>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<reporting>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>${checkstyle-maven-plugin.version}</version>
				<configuration>
					<configLocation>checkstyle.xml</configLocation>
				</configuration>
			</plugin>
		</plugins>
	</reporting>
</project>
