<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.kmp.aeroparker</groupId>
		<artifactId>aeroparker-build</artifactId>
		<version>1.0.0</version>
		<relativePath>../aeroparker-build/pom.xml</relativePath>
	</parent>

	<artifactId>aeroparker-crm-admin</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>

	<name>aeroparker-crm-admin</name>
	<url>http://maven.apache.org</url>

	<distributionManagement>
		<repository>
			<id>central</id>
			<name>releases</name>
			<url>${url.ext-release-local}</url>
		</repository>
		<snapshotRepository>
			<id>snapshots</id>
			<name>snapshots</name>
			<url>${url.ext-snapshot-local}</url>
		</snapshotRepository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java-version>1.8</java-version>
		<aeroparker-version>1.0.0</aeroparker-version>
		<aeroparker-snapshot-version>0.0.1-SNAPSHOT</aeroparker-snapshot-version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-core</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-crm</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
			<version>3.1.0</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>jstl</groupId>
			<artifactId>jstl</artifactId>
			<version>1.2</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-common-test</artifactId>
			<version>${aeroparker-snapshot-version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>aeroparker-crm-admin</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>2.1</version>
				<configuration>
					<source>${java-version}</source>
					<target>${java-version}</target>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
