<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<artifactId>api-gen</artifactId>
	<packaging>jar</packaging>

	<name>AeroParker API Application - Generated Files</name>
	<url>http://www.aeroparker.com</url>

	<properties>
		<aeroparker-core-version>1.0.0</aeroparker-core-version>
		<jaxb-version>2.2.11</jaxb-version>
		<jackson-databind-version>2.12.6.1</jackson-databind-version>
		<jackson-version>2.12.6</jackson-version>
		<jooq-version>3.10.8</jooq-version>
	</properties>

	<distributionManagement>
		<repository>
			<id>central</id>
			<name>releases</name>
			<url>${url.ext-release-local}</url>
		</repository>
		<snapshotRepository>
			<id>snapshots</id>
			<name>snapshots</name>
			<url>${url.ext-snapshot-local}</url>
		</snapshotRepository>
	</distributionManagement>

	<parent>
		<groupId>com.kmp.aeroparker</groupId>
		<artifactId>aeroparker-external-api-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../aeroparker-external-api-parent</relativePath>
	</parent>

	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>3.8.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
		    <groupId>ch.qos.reload4j</groupId>
		    <artifactId>reload4j</artifactId>
		    <version>1.2.20</version>
		</dependency>
		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
			<version>2.2.12</version>
		</dependency>
		<dependency>
			<groupId>com.sun.xml.bind</groupId>
			<artifactId>jaxb-impl</artifactId>
			<version>${jaxb-version}</version>
		</dependency>
		<dependency>
			<groupId>com.sun.xml.bind</groupId>
			<artifactId>jaxb-core</artifactId>
			<version>${jaxb-version}</version>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>${jackson-databind-version}</version>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.module</groupId>
			<artifactId>jackson-module-jaxb-annotations</artifactId>
			<version>${jackson-version}</version>
		</dependency>
		<dependency>
			<groupId>org.jooq</groupId>
			<artifactId>jooq</artifactId>
			<version>${jooq-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-common-db</artifactId>
			<version>${aeroparker-snapshot-version}</version>
		</dependency>
	</dependencies>

	<build>
		<finalName>api-gen</finalName>
		<plugins>
			<plugin>
				<groupId>org.jooq</groupId>
				<artifactId>jooq-codegen-maven</artifactId>
				<version>${jooq-version}</version>
				<executions>
					<execution>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<jdbc>
								<driver>com.mysql.jdbc.Driver</driver>
								<url>${jdbc.url}</url>
								<user>${jdbc.user}</user>
								<password>${jdbc.password}</password>
							</jdbc>
							<generator>
								<name>org.jooq.util.JavaGenerator</name>
								<database>
									<name>org.jooq.util.mysql.MySQLDatabase</name>
									<includes>
										api_users|api_users_scope|api_request.*|site_availability_api_configuration|external_product|ab_shop_order_barcode|shop_order_third_party_barcode|
										car_park_payment_step_fields|site_payment_step_fields|product_grace_settings|shop_order_invoice_url|shop_order_passenger|amendment_history|
										shop_order_receipt_details|ab_bookings_tax_receipt_details|crm_booking_marketing_opt_in|external_api_booking_upgrade|booking_extension|promotions_promo_codes|
										data_import_summary|manual_refunds|shop_order_extra_hour|reservation_extra_hour|shop_product_extra_hour_appearance|lounge_tariff_extra_hour|partial_payments|
										api_barrier_booking_sent|subscription_booking_details|payments|subscription_booking_language|subscription_contact_membership|subscription_membership_sequence|
										subscription_booking|subscription_custom_value|api_barrier_booking_third_party_sent|rewards|reward_lounge_type|ab_sequence|subscription_booking_car_park|external_api_booking_upgrade
										|api_request_key_bundle|api_request_key_bundle_item|subscription_reference_sequence|company|company_invoice|subscription_booking_encrypted|subscription_booking_membership
										|quotas_subscription|quotas_subscription_product|subscription_product_terms|promotions_promo_codes_bookings|reward_subscription_product_constraint|subscription_promo_booking|product_active_booking_amend_rules|subscription_booking_customer_details
                                        |ab_carparks|ab_carparks_transfer_info|featured_product_appearance|ab_bookings_counts|promotions_promo_codes_bookings|featured_product_constraint|product_parking_booking_fee_configuration
									</includes>
									<inputSchema>kmp_advancebooker</inputSchema>
									<outputSchemaToDefault>true</outputSchemaToDefault>
									<customTypes>
										<customType>
											<name>LocalDateTime</name>
											<type>java.time.LocalDateTime</type>
											<converter>com.kmp.aeroparker.model.db.jooq.converters.TimestampToLocalDateTimeConverter</converter>
										</customType>
									</customTypes>
									<forcedTypes>
										<forcedType>
											<name>LocalDateTime</name>
											<expression>.*</expression>
											<!-- Must be lower case. Many a tear was shed trying to figure 
												this out. -->
											<types>datetime</types>
										</forcedType>
									</forcedTypes>
								</database>
								<strategy>
									<!-- Strategies cannot be in the same project as the generated code, 
										must be in another project that is added as a dependency -->
									<name>com.kmp.aeroparker.model.db.jooq.generators.CleanPojoAndDaoGeneratorStrategy</name>
								</strategy>
								<target>
									<packageName>com.kmp.aeroparker.api</packageName>
									<directory>src/main/generated</directory>
								</target>
								<generate>
									<pojos>true</pojos>
								</generate>
							</generator>
						</configuration>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>mysql</groupId>
						<artifactId>mysql-connector-java</artifactId>
						<version>8.0.33</version>
					</dependency>
				</dependencies>
			</plugin>
			<!-- JAXB xjc plugin that invokes the xjc compiler to compile XML schema into Java classes. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>jaxb2-maven-plugin</artifactId>
				<version>1.5</version>
				<executions>
					<execution>
						<id>xjc</id>
						<goals>
							<goal>xjc</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<!-- The schema directory or xsd files. -->
					<schemaDirectory>${basedir}/src/main/resources/xsd</schemaDirectory>
					<!-- The package in which the source files will be generated. -->
					<packageName>com.kmp.aeroparker.api.model.generated</packageName>
					<!-- The working directory to create the generated java source files. -->
					<outputDirectory>${basedir}/src/main/generated</outputDirectory>
					<clearOutputDir>false</clearOutputDir>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.0.0</version>
				<executions>
					<execution>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>src/main/generated</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.0.0</version>
				<configuration>
					<filesets>
						<fileset>
							<directory>src/main/generated</directory>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.jooq</groupId>
										<artifactId>
											jooq-codegen-maven
										</artifactId>
										<versionRange>
											[${jooq-version},)
										</versionRange>
										<goals>
											<goal>generate</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
