<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.kmp.aeroparker</groupId>
	<artifactId>aeroparker-api-freemarker</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>aeroparker-api-freemarker</name>

	<distributionManagement>
		<repository>
			<id>central</id>
			<name>releases</name>
			<url>${url.libs-release}</url>
		</repository>
		<snapshotRepository>
			<id>snapshots</id>
			<name>snapshots</name>
			<url>${url.libs-snapshot}</url>
		</snapshotRepository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.target>1.8</maven.compiler.target>
		<maven.compiler.source>1.8</maven.compiler.source>
		<swagger-version>1.6.6</swagger-version>
		<swagger-codegen-version>2.4.27</swagger-codegen-version>
		<build-helper-maven-plugin-version>3.0.0</build-helper-maven-plugin-version>
		<maven-clean-plugin-version>3.0.0</maven-clean-plugin-version>
		<checkstyle-version>2.17</checkstyle-version>
		<aeroparker-snapshot-version>0.0.1-SNAPSHOT</aeroparker-snapshot-version>
		<aeroparker-version>1.0.0</aeroparker-version>
		<aws-version>1.12.264</aws-version>
		<spring-boot-version>2.7.1</spring-boot-version>
		<jooq-version>3.14.16</jooq-version>
		<mockito-version>2.15.0</mockito-version>
		<net.trajano.commons-version>2.1.0</net.trajano.commons-version>
		<random-beans-version>3.7.0</random-beans-version>
		<catch-exception-version>1.4.6</catch-exception-version>
		<hamcrest-junit-version>2.0.0.0</hamcrest-junit-version>
		<commons-testing-version>2.1.0</commons-testing-version>
		<mockito-junit-jupiter-version>2.19.0</mockito-junit-jupiter-version>
		<java.version>1.8</java.version>
		<dockerfile-maven-plugin-version>1.4.13</dockerfile-maven-plugin-version>
		<testcontainers-version>1.17.2</testcontainers-version>
		<openhtml.version>1.0.10</openhtml.version>
		<aeroparker-api-invoices-sqs-producer-version>0.0.1-SNAPSHOT</aeroparker-api-invoices-sqs-producer-version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot-version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.amazonaws</groupId>
				<artifactId>aws-java-sdk-bom</artifactId>
				<version>${aws-version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-deploy-plugin</artifactId>
					<version>2.8.2</version>
					<configuration>
						<deployAtEnd>true</deployAtEnd>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.0.0-M5</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<extensions>
			<extension>
				<groupId>com.gkatzioura.maven.cloud</groupId>
				<artifactId>s3-storage-wagon</artifactId>
				<version>1.2</version>
			</extension>
		</extensions>
	</build>

	<modules>
		<module>aeroparker-api-freemarker-sqs-consumer</module>
		<module>aeroparker-api-freemarker-sqs-producer</module>
		<module>aeroparker-api-freemarker-server</module>
		<module>aeroparker-api-freemarker-generated</module>
		<module>aeroparker-api-freemarker-db-config</module>
	</modules>
</project>