<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>shop</artifactId>
	<packaging>war</packaging>
	<name>AeroParker Shop Application</name>
	<url>http://www.aeroparker.com</url>
	<properties>
		<java-version>1.8</java-version>
		<javax.servlet-api-version>3.1.0</javax.servlet-api-version>
		<aeroparker-version>1.0.0</aeroparker-version>
		<aeroparker-payments-shop-version>1.0.0</aeroparker-payments-shop-version>
		<aeroparker-snapshot-version>0.0.1-SNAPSHOT</aeroparker-snapshot-version>
		<axis2-version>1.7.7</axis2-version>
		<maven.build.timestamp.format>yyyy-MM-dd-HH-mm-ss</maven.build.timestamp.format>
		<aeroparker-api-barriers-sqs-producer-version>1.0.1</aeroparker-api-barriers-sqs-producer-version>
		<aeroparker-api-bookings-sqs-producer-version>1.0.5</aeroparker-api-bookings-sqs-producer-version>
		<aws.sdk.version>1.12.725</aws.sdk.version>
	</properties>
	<distributionManagement>
		<repository>
			<id>central</id>
			<name>releases</name>
			<url>${url.ext-release-local}</url>
		</repository>
		<snapshotRepository>
			<id>snapshots</id>
			<name>snapshots</name>
			<url>${url.ext-snapshot-local}</url>
		</snapshotRepository>
	</distributionManagement>
	<parent>
		<groupId>com.kmp.aeroparker</groupId>
		<artifactId>aeroparker-build</artifactId>
		<version>1.0.0</version>
		<relativePath>../aeroparker-build/pom.xml</relativePath>
	</parent>
	<dependencies>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-parking-quotas</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-buckets</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-communicator</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-ancillary-quotas</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-parking-upgrades-shop</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-contacts</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>net.sf.supercsv</groupId>
			<artifactId>super-csv</artifactId>
			<version>2.2.0</version>
		</dependency>
		<dependency>
			<groupId>org.apache.tomcat</groupId>
			<artifactId>tomcat-coyote</artifactId>
			<version>7.0.100</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>jstl</groupId>
			<artifactId>jstl</artifactId>
			<version>1.2</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-payments-shop</artifactId>
			<version>${aeroparker-payments-shop-version}</version>
		</dependency>
		<dependency>
			<groupId>com.google.zxing</groupId>
			<artifactId>core</artifactId>
			<version>3.2.1</version>
		</dependency>
		<dependency>
			<groupId>com.google.zxing</groupId>
			<artifactId>javase</artifactId>
			<version>3.2.1</version>
		</dependency>
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
			<version>${javax.servlet-api-version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.httpcomponents</groupId>
			<artifactId>httpcore</artifactId>
			<version>4.4.5</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-api-barriers-sqs-producer</artifactId>
			<version>${aeroparker-api-barriers-sqs-producer-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-api-bookings-sqs-producer</artifactId>
			<version>${aeroparker-api-bookings-sqs-producer-version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.axis2</groupId>
			<artifactId>axis2-transport-http</artifactId>
			<version>${axis2-version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.axis2</groupId>
			<artifactId>axis2-adb</artifactId>
			<version>${axis2-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-common-test</artifactId>
			<version>${aeroparker-snapshot-version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-social-auth</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>com.kmp.aeroparker</groupId>
			<artifactId>aeroparker-widget-shop</artifactId>
			<version>${aeroparker-version}</version>
		</dependency>
		<dependency>
			<groupId>com.google.code.bean-matchers</groupId>
			<artifactId>bean-matchers</artifactId>
			<version>0.11</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>net.bull.javamelody</groupId>
			<artifactId>javamelody-core</artifactId>
			<version>1.78.0</version>
		</dependency>
		<dependency>
			<groupId>se.jiderhamn.classloader-leak-prevention</groupId>
			<artifactId>classloader-leak-prevention-servlet3</artifactId>
			<version>2.7.0</version>
		</dependency>
		<dependency>
			<groupId>com.amazonaws</groupId>
			<artifactId>aws-java-sdk-core</artifactId>
			<version>${aws.sdk.version}</version>
		</dependency>
		<dependency>
			<groupId>com.amazonaws</groupId>
			<artifactId>aws-java-sdk-sqs</artifactId>
			<version>${aws.sdk.version}</version>
		</dependency>
		<dependency>
		    <groupId>org.dhatim</groupId>
		    <artifactId>fastexcel</artifactId>
		    <version>0.10.12</version>
		</dependency>
		<dependency>
		    <groupId>ch.qos.reload4j</groupId>
		    <artifactId>reload4j</artifactId>
			<version>1.2.20</version>
		</dependency>
		<dependency>
		    <groupId>com.sun.mail</groupId>
		    <artifactId>jakarta.mail</artifactId>
		    <version>1.6.7</version>
		</dependency>
		<dependency>
		    <groupId>org.json</groupId>
		    <artifactId>json</artifactId>
			<version>20160810</version>
		</dependency>
		<dependency>
		    <groupId>org.codehaus.woodstox</groupId>
		    <artifactId>stax2-api</artifactId>
		    <version>3.1.4</version>
		</dependency>
	</dependencies>
	<build>
		<finalName>Shop</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>2.1</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<version>2.6</version>
				<configuration>
					<overlays>
						<overlay>
							<id>aeroparker-payments-shop</id>
							<groupId>com.kmp.aeroparker</groupId>
							<artifactId>aeroparker-payments-shop</artifactId>
							<type>jar</type>
							<includes>
								<include>**/*.jsp</include>
							</includes>
							<targetPath></targetPath>
						</overlay>
						<overlay>
							<id>aeroparker-parking-upgrades-shop</id>
							<groupId>com.kmp.aeroparker</groupId>
							<artifactId>aeroparker-parking-upgrades-shop</artifactId>
							<type>jar</type>
							<includes>
								<include>**/*.jsp</include>
							</includes>
							<targetPath></targetPath>
						</overlay>
						<overlay>
							<id>aeroparker-widget-shop</id>
							<groupId>com.kmp.aeroparker</groupId>
							<artifactId>aeroparker-widget-shop</artifactId>
							<type>jar</type>
							<includes>
								<include>**/*.jsp</include>
							</includes>
							<targetPath></targetPath>
						</overlay>
					</overlays>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>com.google.cloud.tools</groupId>
					<artifactId>jib-maven-plugin</artifactId>
					<version>3.3.2</version>
					<configuration>
						<from>
							<image>515903409859.dkr.ecr.eu-west-1.amazonaws.com/aeroparker-tomcat:${from.image.tag}</image>
						</from>
						<to>
							<image>${aws.ecr.repo}/aeroparker-shop:${image.tag.latest}</image>
							<tags>
								<tag>${image.tag.timestamp}</tag>
							</tags>
						</to>
						<extraDirectories>
							<paths>
								<path>
									<from>../third_party/opentelemetry-javaagent/release</from>
									<into>/otel</into>
								</path>
							</paths>
						</extraDirectories>
						<container>
							<appRoot>/usr/local/tomcat/webapps/${image.approot}</appRoot>
							<environment>
								<JAVA_OPTS>-DDB_URL="${DB_URL}" -DDB_USER=${DB_USER} -DDB_PASSWORD=${DB_PASSWORD} -DDB_MAX_POOL_SIZE=${DB_MAX_POOL_SIZE} -DLOG_FILE=/AdvanceBooker/config/log/log4j.xml -Dlog.email.from=${LOG_EMAIL_FROM} -Dlog.email.to=${LOG_EMAIL_TO} -Dlog.email.subject="${LOG_EMAIL_SUBJECT}" -Dlog.level=${LOG_LEVEL} -javaagent:/otel/opentelemetry-javaagent.jar</JAVA_OPTS>
							</environment>
						</container>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
	<description>The Tomcat web application for Shop.</description>
</project>
