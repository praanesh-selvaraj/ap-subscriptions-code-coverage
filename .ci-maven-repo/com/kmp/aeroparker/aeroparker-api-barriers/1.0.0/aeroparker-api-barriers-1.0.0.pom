<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.kmp.aeroparker</groupId>
	<artifactId>aeroparker-api-barriers</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>
	<name>aeroparker-api-barriers</name>

	<distributionManagement>
		<repository>
			<id>central</id>
			<name>releases</name>
			<url>${url.libs-release}</url>
		</repository>
		<snapshotRepository>
			<id>snapshots</id>
			<name>snapshots</name>
			<url>${url.libs-snapshot}</url>
		</snapshotRepository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.target>1.8</maven.compiler.target>
		<maven.compiler.source>1.8</maven.compiler.source>
		<swagger-version>1.6.6</swagger-version>
		<swagger-codegen-version>2.4.27</swagger-codegen-version>
		<build-helper-maven-plugin-version>3.0.0</build-helper-maven-plugin-version>
		<maven-clean-plugin-version>3.0.0</maven-clean-plugin-version>
		<checkstyle-version>2.17</checkstyle-version>
		<aeroparker-snapshot-version>0.0.1-SNAPSHOT</aeroparker-snapshot-version>
		<aeroparker-version>1.0.0</aeroparker-version>
		<aws-version>1.12.320</aws-version>
		<spring-boot-version>2.7.5</spring-boot-version>
		<jooq-version>3.14.15</jooq-version>
		<mockito-version>2.15.0</mockito-version>
		<random-beans-version>3.7.0</random-beans-version>
		<catch-exception-version>1.4.6</catch-exception-version>
		<hamcrest-junit-version>2.0.0.0</hamcrest-junit-version>
		<log4j-version>1.2.17</log4j-version>
		<commons-testing-version>2.1.0</commons-testing-version>
		<mockito-junit-jupiter-version>2.19.0</mockito-junit-jupiter-version>
		<mysql-connector-version>8.0.28</mysql-connector-version>
		<jackson-core-version>2.12.6</jackson-core-version>
		<jackson-databind-version>2.12.6.1</jackson-databind-version>
		<swagger-v3-codegen-version>3.0.32</swagger-v3-codegen-version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.amazonaws</groupId>
				<artifactId>aws-java-sdk-bom</artifactId>
				<version>${aws-version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot-version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>io.swagger</groupId>
				<artifactId>swagger-core</artifactId>
				<version>${swagger-version}</version>
			</dependency>
			<dependency>
				<groupId>io.swagger</groupId>
				<artifactId>swagger-jersey2-jaxrs</artifactId>
				<version>${swagger-version}</version>
			</dependency>
			<dependency>
				<groupId>io.swagger.codegen.v3</groupId>
                <artifactId>swagger-codegen-maven-plugin</artifactId>
                <version>${swagger-v3-codegen-version}</version>
			</dependency>
			<dependency>
				<groupId>mysql</groupId>
				<artifactId>mysql-connector-java</artifactId>
				<version>8.0.29</version>
			</dependency>
			<dependency>
				<groupId>org.mockito</groupId>
				<artifactId>mockito-core</artifactId>
				<version>${mockito-version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>io.github.benas</groupId>
				<artifactId>random-beans</artifactId>
				<version>${random-beans-version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>eu.codearte.catch-exception</groupId>
				<artifactId>catch-exception</artifactId>
				<version>${catch-exception-version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.hamcrest</groupId>
				<artifactId>hamcrest-junit</artifactId>
				<version>${hamcrest-junit-version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>net.trajano.commons</groupId>
				<artifactId>commons-testing</artifactId>
				<version>${commons-testing-version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.mockito</groupId>
				<artifactId>mockito-junit-jupiter</artifactId>
				<version>${mockito-junit-jupiter-version}</version>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<modules>
		<module>aeroparker-api-barriers-server</module>
		<module>aeroparker-api-barriers-client</module>
		<module>aeroparker-api-barriers-generated</module>
		<module>aeroparker-api-barriers-sqs-producer</module>
		<module>aeroparker-api-barriers-sqs-consumer</module>
		<module>aeroparker-api-barriers-status</module>
		<module>aeroparker-api-barriers-transactions-function</module>
		<module>aeroparker-api-barriers-overstay</module>
		<module>aeroparker-api-barriers-overstay-notifications</module>
		<module>aeroparker-api-barriers-interparking-transaction-function</module>
		<module>aeroparker-api-barriers-interparking-feedback</module>
		<module>aeroparker-api-barriers-delay</module>
		<module>aeroparker-api-barriers-anonymise-data</module>
		<module>aeroparker-api-barriers-db-config</module>
	</modules>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.0.0-M6</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<extensions>
			<extension>
				<groupId>com.gkatzioura.maven.cloud</groupId>
				<artifactId>s3-storage-wagon</artifactId>
				<version>1.2</version>
			</extension>
		</extensions>
	</build>
</project>